# Strict allowlist for Vercel uploads. Everything is excluded by `*`, then the
# build inputs are re-included. Private records (docs/, *.pdf/xlsx/csv/heic/zip),
# secrets (.env*), local archives, and generated output (site/, node_modules/)
# are therefore never uploaded. Vercel builds site/ from these inputs on deploy
# via `npm run build` (buildCommand in vercel.json), and detects api/ functions
# and middleware.js automatically.
*

!src
!src/**
!scripts
!scripts/**
!api
!api/**
!middleware.js
!package.json
!package-lock.json
!vercel.json
