{
  "name": "blkpvnthr-llc-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Corporate website for BLKPVNTHR LLC — blkpvnthr.com",
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "rm -rf site",
    "dev": "node scripts/build.mjs && npx --yes serve site -l 4321",
    "format": "prettier --write \"src/**/*.{html,css,js,mjs,json}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{html,css,js,mjs,json}\" \"scripts/**/*.mjs\"",
    "validate": "npm run build && node scripts/validate.mjs site",
    "test:unit": "node --test scripts/claims.test.mjs scripts/evidence-graph.test.mjs",
    "test": "npm run format:check && npm run validate && npm run test:unit"
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@vercel/edge": "^1.3.3"
  }
}
