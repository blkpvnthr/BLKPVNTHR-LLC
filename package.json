{
  "name": "blkpvnthr-llc-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Corporate website for BLKPVNTHR LLC — blkpvnthr.com",
  "scripts": {
    "dev": "npx --yes serve site -l 4321",
    "format": "prettier --write \"site/**/*.{html,css,js}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"site/**/*.{html,css,js}\" \"scripts/**/*.mjs\"",
    "validate": "node scripts/validate.mjs site",
    "test:unit": "node --test scripts/claims.test.mjs",
    "test": "npm run format:check && npm run validate && npm run test:unit"
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=20"
  }
}
